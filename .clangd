CompileFlags:
  Add:
    - /std:c++20
    - /MTd
    - /nologo
    - /GR-
    - /EHs-
    - /EHc-
    - /Od
    - /Oi
    - /W4
    - /FC
    - /Z7
    - /RTC1
    - /DUNICODE
    - /D_UNICODE
    - /D_DEBUG_TMP=1
    - /D_DEBUG_VIS=1
    - /D_DEBUG_BUILD=1
    - /Iinclude
    - /clang:-fdiagnostics-show-option
    - /clang:-Wno-microsoft-goto

Index:
  Background: Build

InlayHints:
  Enabled: No

Diagnostics:
  Suppress:
    - unused-includes

Completion:
  HeaderInsertion: Never
